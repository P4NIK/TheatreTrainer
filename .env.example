# Kopie als `.env` anlegen und anpassen – nur für den Docker-Weg nötig.

# Port auf dem Server. Innen läuft die App immer auf 8080.
THEATER_PORT=8080

# Wem die Dateien in data/ und voices/ gehören sollen: `id -u` und `id -g`.
PUID=1000
PGID=1000

# Stimmen, die beim ersten Start geladen werden, wenn sie fehlen.
# Mehrere durch Leerzeichen trennen, leer lassen für „lade nichts“.
THEATER_VOICES=de_DE-thorsten-medium

# Spracherkennung für den Lernmodus mit ins Image bauen (1) oder nicht (0).
# Mit 1 wächst das Image um mehrere Gigabyte, weil PyTorch mitkommt.
INCLUDE_WHISPER=0
WHISPER_MODEL=small

# Pause zwischen zwei Blöcken und Ersatzpause für die eigene Rolle, in ms.
THEATER_GAP_MS=450
THEATER_SKIP_PAUSE_MS=2500
