,0.726,0.0143,"sich, legt ihn recht unsanft auf dem Schreibtisch ab und setzt sich auf den Bürostuhl, ohne",0,1],[0.1192,0.355,0.3789,0.0143,"Wilhelm mit einem einzigen Blick zu würdigen.",0,1],[0.5032,0.355,0.3198,0.0143,"Sie öffnet den Ordner, blickt hinein und",0,1],[0.1192,0.3714,0.2519,0.0143,"blättert ihn etwas mürrisch dur",0,1],[0.3712,0.3714,0.024,0.0143,"ch.",0,1],[0.1192,0.4041,0.498,0.0143,"Wilhelm räuspert sich diskret, um sich bemerkbar zu machen.",0,1],[0.1192,0.4369,0.0605,0.0143,"Gisela:",1,0],[0.1847,0.4369,0.6499,0.0143,"(blickt mit finsterem Blick von ihrem Ordner auf, über den Rand ihrer Lesebrille",0,1],[0.1192,0.4533,0.1698,0.0143,"hinweg, fragt forsch)",0,1],[0.2939,0.4533,0.1472,0.0143,"Welche Nummer?",0,0],[0.4462,0.4533,0.2896,0.0143,"(sieht dann wieder in ihren Ordner)",0,1],[0.1192,0.486,0.0808,0.0143,"Wilhelm:",1,0],[0.205,0.486,0.1308,0.0143,"(irritiert, kommt",0,1],[0.3409,0.486,0.3207,0.0143,"etwas näher an den Schreibtisch heran)",0,1],[0.1192,0.5024,0.0895,0.0143,"Bitte, was?",0,0],[0.1192,0.5351,0.0605,0.0143,"Gisela:",1,0],[0.1847,0.5351,0.2445,0.0143,"(fordernder, ohne aufzusehen)",0,1],[0.1192,0.5515,0.1158,0.0143,"Ihre Nummer!",0,0],[0.1192,0.5843,0.0808,0.0143,"Wilhelm:",1,0],[0.1192,0.6007,0.22,0.0143,"Was denn für’ne Nummer?",0,0],[0.1192,0.6335,0.0605,0.0143,"Gisela:",1,0],[0.1847,0.6335,0.1874,0.0143,"(blickt ihn grimmig an)",0,1],[0.1192,0.6497,0.1605,0.0143,"Ihre Wartenummer!",0,0],[0.1192,0.6826,0.0808,0.0143,"Wilhelm:",1,0],[0.205,0.6826,0.1883,0.0143,"(zuckt mit den Achseln)",0,1],[0.1192,0.699,0.123,0.0143,"Keine Ahnung.",0,0],[0.1192,0.7317,0.0605,0.0143,"Gisela:",1,0],[0.1192,0.7481,0.0437,0.0143,"Ohne",0,0],[0.1677,0.7481,0.4282,0.0143,"gültige Wartenummer haben Sie hier keinen Zugang.",0,0],[0.1192,0.7809,0.0808,0.0143,"Wilhelm:",1,0],[0.1192,0.7973,0.5355,0.0143,"Zu was habe ich keinen Zugang? Wo bin ich denn hier überhaupt?",0,0],[0.1192,0.8299,0.0605,0.0143,"Gisela:",1,0],[0.1192,0.8463,0.6671,0.0143,"Fragen 