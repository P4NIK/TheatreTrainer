nden sich Ablagen und Ordner die jeweils weiß, blau",0,0],[0.1192,0.7216,0.6241,0.0143,"und rot sind. Sie sollten auch nach diesen Farben sortiert in den Regalen zu fi",0,0],[0.7435,0.7216,0.0816,0.0143,"nden sein.",0,0],[0.1192,0.7379,0.7615,0.0143,"In einem größeren Abstand zu dem Schreibtisch stehen zwei Reihen mit jeweils vier Stühlen.",0,0],[0.1192,0.7543,0.482,0.0143,"Sie sollten, wenn möglich alle gleich und sehr schlicht sein.",0,0],[0.1192,0.787,0.7612,0.0143,"Das Verwaltungspersonal trägt die gleichen blauen, bodenlangen Überwürfe. Diese müssen",0,0],[0.1192,0.8034,0.0346,0.0143,"zum",0,0],[0.1681,0.8034,0.0414,0.0143,"Ende",0,0],[0.2238,0.8034,0.0268,0.0143,"des",0,0],[0.2649,0.8034,0.0526,0.0143,"dritten",0,0],[0.3318,0.8034,0.0469,0.0143,"Aktes",0,0],[0.393,0.8034,0.0681,0.0143,"abgelegt",0,0],[0.4754,0.8034,0.0643,0.0143,"werden.",0,0],[0.554,0.8034,0.0714,0.0143,"Darunter",0,0],[0.6397,0.8034,0.0504,0.0143,"tragen",0,0],[0.7043,0.8034,0.0249,0.0143,"die",0,0],[0.7434,0.8034,0.0571,0.0143,"Spieler",0,0],[0.8147,0.8034,0.066,0.0143,"normale",0,0],[0.1192,0.8198,0.3252,0.0143,"Straßenkleidung oder Businesskleidung.",0,0],[0.1192,0.8526,0.5552,0.0143,"Philippus benötigt ein Engelskostüm und Luzifer ein Teufelskostüm.",0,0],[0.2085,0.0194,0.3441,0.0131,"Plausus Theaterverlag GmbH & Co. KG",1,0],[0.2085,0.0345,0.1026,0.0118,"Kasernenstr.",1,0],[0.3157,0.0345,0.0186,0.0118,"56",1,0],[0.3692,0.0345,0.0869,0.0118,"Tel. +49 (0)",1,0],[0.4611,0.0345,0.0278,0.0118,"228",1,0],[0.4937,0.0345,0.0047,0.0118,"/",1,0],[0.503,0.0345,0.028,0.0118,"444",1,0],[0.5357,0.0345,0.0281,0.0118,"777",1,0],[0.5686,0.0345,0.0186,0.0118,"77",1,0],[0.5956,0.0345,0.067,0.0118,"Internet:",1,0],[0.6673,0.0345,0.1313,0.0118,"www.plausus.de",1,0],[0.2085,0.0482,0.0121,0.0118,"D",1,0],[0.2206,0.0482,0.0056,0.0118,"-",1,0],[0.2262,0.0482,0.094,0.0118,"53111 Bonn",1,0],[0.3692,0.0482,0.0869,0.0118,"Fax +49 (0)",1,0],[0.4611,0.0482,0.0278,0.0118,"228",1,0],[0.4937,0.0482,0.0047,0.0118,"/",1,0